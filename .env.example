w# Copy this file to .env and fill in real values.
# For `docker compose up`, only the values below are needed — DATABASE_URL/DIRECT_URL
# are set automatically in docker-compose.yml to point at the bundled Postgres container.

# --- Database (PostgreSQL — e.g. Supabase) ---
# Not needed when running via docker-compose; required for local `npm run dev`.
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Authentication ---
JWT_SECRET="replace-with-a-long-random-string"

# --- Google Gemini (Aether AI) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Cloudinary (profile photos, prescription images) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- SerpAPI (nearby pharmacies) ---
SERPAPI_KEY="your-serpapi-key"

# --- Seeded admin login (src/app/actions/adminActions.ts) ---
ADMIN_EMAIL="admin@medicare.com"
# Preferred: a bcrypt hash of the admin password, so the password itself never sits in
# the environment (where a log dump, crash report or shared .env would expose it).
# Generate one with:  node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" "your-password"
ADMIN_PASSWORD_HASH=""
# Fallback, used only when ADMIN_PASSWORD_HASH is empty. Works, but logs a warning at
# login — prefer the hash above for anything reachable from the internet.
ADMIN_PASSWORD="replace-with-a-strong-password"

# --- App URL: base address used to build "Join video call" links inside emails ---
# Localhost is fine for local testing. On a real deployment set this to the address
# patients actually use, or the links in their email point at their own machine.
# On Vercel this is auto-detected from VERCEL_URL if left unset.
APP_URL="http://localhost:3000"

# --- Video consultations (Jitsi) ---
# Defaults to the public meet.jit.si server. Point this at your own Jitsi deployment
# to avoid the public server's moderator/lobby prompts.
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# --- SMTP (appointment confirmation emails) ---
# Leave blank to disable email: bookings still succeed and the skipped mail is logged.
# Gmail needs an App Password (not the account password) with 2FA enabled.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-address@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
MAIL_FROM="MediCare <your-address@gmail.com>"
