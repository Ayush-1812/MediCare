// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  image        String?
  address      Json?         @default("{\"line1\":\"\",\"line2\":\"\"}")
  gender       String        @default("Not Selected")
  dob          String        @default("Not Selected")
  phone        String        @default("0000000000")

  // --- Health profile: optional, filled in from "Complete your health profile" ---
  // All nullable on purpose: the dashboard shows these cards only once real values
  // exist, rather than displaying placeholder numbers.
  heightCm    Int?
  weightKg    Float?
  bloodGroup  String?
  allergies   String?

  appointments   Appointment[]
  prescriptions  Prescription[]
  conversations  Conversation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Doctor {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  image        String?
  speciality   String?
  degree       String?
  experience   String?
  about        String?
  languages    String?
  awards       String?
  available    Boolean       @default(true)
  fees         Int?
  address      Json?

  // --- Profile details patients rely on when choosing a doctor ---
  gender            String?  @default("Not Selected")
  phone             String?
  registrationNo    String?
  hospital          String?
  city              String?
  consultationModes Json     @default("[\"Video Consultation\"]")

  // --- Consulting hours: which days, between what times, in what slot size ---
  availableDays Json   @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  slotStartTime String @default("10:00")
  slotEndTime   String @default("17:00")
  slotDuration  Int    @default(30)

  rating       Float?
  totalReviews Int    @default(0)

  // Defaults to true so doctors that already exist (added by an admin, whose form
  // already collects every field) stay visible. Self sign-up passes false explicitly,
  // which holds the doctor in onboarding until they submit the profile form.
  profileCompleted Boolean @default(true)

  createdAt    Int           @default(dbgenerated("extract(epoch from now())::int"))
  slots_booked Json          @default("{}")
  appointments Appointment[]
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  docId       String
  slotDate    String
  slotTime    String
  userData    Json
  docData     Json
  amount      Int
  date        Int      @default(dbgenerated("extract(epoch from now())::int"))
  cancelled   Boolean  @default(false)
  payment     Boolean  @default(false)
  isCompleted Boolean  @default(false)
  meetingId   String?
  user        User     @relation(fields: [userId], references: [id])
  doctor      Doctor   @relation(fields: [docId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startTime    DateTime?
  endTime      DateTime?
  duration     Int?
  diagnosis    String?
  prescription String?
  // The doctor's own private notes — never sent to the patient. See
  // `getConsultationDetails`, which nulls this out for anyone but the doctor.
  notes        String?
  // The patient's personal notes from the consultation, written during or after the
  // call. Kept separate from `notes` precisely because that one is doctor-only: the two
  // are different people's private writing about the same appointment.
  patientNotes String?
  followUpDate DateTime?
}

model Prescription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  imageUrl      String   @db.Text
  extractedData Json?    @default("{}")
  medicines     Json     @default("[]")

  // The handwritten content of the prescription, kept as text alongside the image.
  // `rawText` is the OCR output verbatim so nothing the scan read is ever lost, and
  // `notes` holds the advice / follow-up lines after the patient has reviewed them.
  rawText String? @db.Text
  notes   String? @db.Text

  // Provenance for the extraction, so a low-quality scan is identifiable later.
  ocrEngine     String?
  ocrConfidence Float?

  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Conversation {
  id            String    @id @default(cuid())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String    @default("New Conversation")

  messages      Message[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lastMessageAt DateTime?    // Helps sort chats by recent activity

  @@index([userId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           MessageRole

  content        String       @db.Text

  createdAt      DateTime     @default(now())

  model          String?

  toolUsed       String?

  tokenUsage     Int?

  metadata       Json?

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}